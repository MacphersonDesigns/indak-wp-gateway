# --- ClickUp -> gateway -------------------------------------------------
# openssl rand -hex 32
GATEWAY_TOKEN=replace-me-with-64-hex-chars

# Optional second token that can only run read-class abilities.
# Hand this one to account managers. openssl rand -hex 32
GATEWAY_TOKEN_READONLY=

# --- gateway -> WordPress ----------------------------------------------
# One WordPress Application Password per site, for that site's novamira-bot user.
# The env var name comes from "appPasswordEnv" in registry.json.
WP_PW_INDAK=xxxx xxxx xxxx xxxx xxxx xxxx
WP_PW_STRENGTHENND=xxxx xxxx xxxx xxxx xxxx xxxx

# --- safety ------------------------------------------------------------
# Leave UNSET. Setting this to true permits PHP execution, file writes and
# WP-CLI on sites marked env:"live". Do the work on staging instead.
# ALLOW_LIVE_ROOT=true

# --- site registry -----------------------------------------------------
# SIMPLEST, and what to use on a hosting panel. No quotes, no braces, so
# nothing for the panel's env var editor to escape. One site per line:
#
#   key | Label | https://url | live or staging | writes (optional)
#
# env is guessed from the URL if omitted. writes defaults to true on staging,
# false on live.
# A bare URL is enough; the key and label come from the domain.
SITES=https://mysticonnd.com

# Alternatives, in order of precedence: SITES > REGISTRY_B64 > REGISTRY_JSON >
# registry.json file. Use a JSON form only if you need per-site "user",
# "mcpPath", "rateLimitPerMin" or "timeoutMs".
# REGISTRY_B64=<base64 of the registry JSON>
# REGISTRY_JSON={"indak":{"label":"Indak Media","base":"https://indakmedia.com","env":"live","appPasswordEnv":"WP_PW_INDAK","writes":false}}

# --- server ------------------------------------------------------------
# Railway / Fly / Render inject PORT themselves. Only set it locally.
PORT=8080
MCP_PATH=/mcp
REGISTRY_FILE=registry.json

# --- persistent paired-site registry -----------------------------------
# These replace per-site variables after a site is paired. SITES remains a fallback.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=indak_gateway
DB_USER=indak_gateway
DB_PASSWORD=local-development-only

# Docker-only values are deliberately separate from production DB_* variables.
LOCAL_DB_FORWARD_PORT=3307
LOCAL_DB_NAME=indak_gateway
LOCAL_DB_USER=indak_gateway
LOCAL_DB_PASSWORD=local-development-only
LOCAL_DB_ROOT_PASSWORD=local-root-development-only

# Generate each independently with: openssl rand -hex 32
GATEWAY_ADMIN_TOKEN=replace-me-with-a-different-64-character-hex-token
REGISTRY_ENCRYPTION_KEY=replace-me-with-a-64-character-hex-encryption-key
